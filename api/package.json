    "clean": "rm -rf lib",
    "clean-logs": "rm ~/.npm/_logs/*.log",
    "test": "jest --coverage"
  },
  "devDependencies": {
    "@types/bunyan": "^1.8.8",
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/sqlite3": "^3.1.8",
    "jest": "^30.5.2",
    "jest-express": "^1.12.0",
    "nodemon": "^2.0.22",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bunyan": "^1.8.15",
    "connect-history-api-fallback": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^6.4.0",
    "sqlite3": "^6.0.1"
  },
  "nodemonConfig": {
    "ignore": [
      "test/*",
      "docs/*"
    ],
    "delay": "2500"
