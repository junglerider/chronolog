  "description": "Sqlite 3 powered API for Chronolog time sheet application",
  "main": "lib/index.js",
  "author": "Thomas Knierim <chronolog@thomasknierim.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node_modules/typescript/bin/tsc -p .",
    "watch": "node_modules/typescript/bin/tsc -w -p .",
