#!/bin/bash
# Executes production build steps of chronolog application

set -euo pipefail

cd "$(dirname "$0")"

usage() {
    echo "Usage: build.sh [-h|--help] [db [--force]|install|app|api|all|docker]"
    echo "       install - installs dependencies for the frontend and backend"
    echo "       app    - creates the Vue frontend"
    echo "       api    - creates the Node.js backend"
    echo "       db     - creates chronolog.db; use --force to replace an existing file"
    echo "       all    - creates frontend, backend and database"
    echo "       docker - creates frontend, backend, database and Docker image"
}

build_db() {
    local force=false
    if [[ $# -eq 1 && "${1:-}" == "--force" ]]; then
        force=true
    elif [[ $# -gt 0 ]]; then
        usage >&2
        return 2
    fi

    local database=./db/chronolog.db
    if [[ -e "$database" && "$force" != true ]]; then
        echo "Keeping existing database: $database"
        return 0
    fi

    local temporary_database
    temporary_database=$(mktemp ./db/.chronolog.db.XXXXXX)
    echo "creating new database: chronolog.db"
    if ! sqlite3 "$temporary_database" < ./db/schema.sql ||
       ! sqlite3 "$temporary_database" < ./db/fixtures.sql; then
        rm -f "$temporary_database"
        return 1
    fi
    chmod 644 "$temporary_database"

    if [[ "$force" == true ]]; then
        mv -f "$temporary_database" "$database"
    elif ! ln "$temporary_database" "$database"; then
        echo "Cannot replace $database; pass 'db --force' to overwrite it." >&2
        rm -f "$temporary_database"
        return 1
    else
        rm -f "$temporary_database"
    fi
    ls -lh ./db/chronolog.db
}

build_app() {
    echo "creating Vue web application"
    npm run build --prefix ./app
}

install_dependencies() {
    npm install --prefix ./app
    npm install --prefix ./api
}

build_api() {
    echo "creating Node.js API"
    npm run clean --prefix ./api
    npm run build --prefix ./api
}

build_all() {
    build_api
    build_app
    build_db
}

build_docker() {
    build_all
    docker build -t chronolog .
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

while [ "$1" != "" ]; do
    case $1 in
        -h | --help )   usage
                        exit
                        ;;
        db )            shift
                        build_db "$@"
                        exit $?
                        ;;
        install )       install_dependencies
                        exit
                        ;;
        app )           build_app
                        exit
                        ;;
        api )           build_api
                        exit
                        ;;
        all )           build_all
                        exit
                        ;;
        docker )        build_docker
                        exit
                        ;;
        * )             usage
                        exit 1
    esac
    shift
done
